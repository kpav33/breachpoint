# Static client image (Coolify / any Docker host). The game server has its own
# image (./Dockerfile); in Coolify point the frontend app's Dockerfile Location
# at /Dockerfile.client. Exists because Nixpacks pins Node 22.11, below the
# >=22.12 that Vite 8's rolldown native binding requires — npm silently skips
# the optional binding on engine mismatch and the build fails later.
FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite bakes this into the bundle at build time — must be set as a BUILD
# variable in Coolify (public wss:// URL of the game server).
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=$VITE_SERVER_URL

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Stock nginx doesn't gzip JS; the Phaser bundle is large enough to care.
# Vite's hashed /assets/ files are immutable, so cache them forever.
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 80
